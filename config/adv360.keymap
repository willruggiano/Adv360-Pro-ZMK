#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        hmlt: hmlt {
            compatible = "zmk,behavior-hold-tap";
            label = "HMLT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
        };

        hmrt: hmrt {
            compatible = "zmk,behavior-hold-tap";
            label = "HMRT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2           &kp N3        &kp N4        &kp N5  &tog 1                                                                 &mo 3      &kp N6  &kp N7        &kp N8        &kp N9            &kp N0        &kp MINUS
&kp TAB    &kp Q      &kp W            &kp E         &kp R         &kp T   &none                                                                  &none      &kp Y   &kp U         &kp I         &kp O             &kp P         &kp BSLH
&kp ESC    &hmlt 4 A  &hml LEFT_ALT S  &hml LSHFT D  &hml LCTRL F  &kp G   &tog 4     &kp BACKSPACE  &kp LMETA         &kp RMETA      &kp DELETE  &tog 4     &kp H   &hmr RCTRL J  &hmr RSHFT K  &hmr RIGHT_ALT L  &hmrt 4 SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X            &kp C         &kp V         &kp B                             &kp LEFT_ALT      &kp RIGHT_ALT                         &kp N   &kp M         &kp COMMA     &kp DOT           &kp FSLH      &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS         &kp LEFT      &kp RIGHT             &kp LSHFT  &kp SPACE      &kp LCTRL         &kp RCTRL      &kp RET     &kp RSHFT          &kp UP        &kp DOWN      &kp LBKT          &kp RBKT      &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &trans  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &trans
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &trans  &kp N7      &kp N8        &kp N9         &kp KP_MINUS     &trans
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &trans  &kp N4      &kp N5        &kp N6         &kp KP_PLUS      &trans
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N0  &kp N1      &kp N2        &kp N3         &kp KP_ENTER     &trans
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &trans           &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        symbol {
            display-name = "Sym";
            bindings = <
&kp TILDE          &kp DOLLAR    &kp PERCENT  &kp CARET   &trans                &kp AT         &tog 1                                                              &mo 3      &kp AT            &trans    &kp CARET   &kp PERCENT  &kp DOLLAR    &kp GRAVE
&kp TAB            &trans        &kp PLUS     &kp ASTRK   &kp LBKT              &kp AMPS       &none                                                               &none      &kp AMPS          &kp RBKT  &kp ASTRK   &kp PLUS     &trans        &kp TAB
&kp DOUBLE_QUOTES  &kp COLON     &kp MINUS    &kp COMMA   &kp LEFT_PARENTHESIS  &kp LESS_THAN  &tog 4     &kp BACKSPACE  &kp LMETA         &kp RMETA      &kp DEL  &tog 4     &kp GREATER_THAN  &kp RPAR  &kp COMMA   &kp MINUS    &kp SEMI      &kp APOS
&kp EXCL           &kp QUESTION  &kp EQUAL    &kp PERIOD  &kp LBRC              &kp BACKSLASH                            &kp LEFT_ALT      &kp RIGHT_ALT                      &kp SLASH         &kp RBRC  &kp PERIOD  &kp EQUAL    &kp QUESTION  &kp EXCL
&mo 2              &none         &kp HASH     &kp LEFT    &kp RIGHT                            &kp LSHFT  &kp SPACE      &kp LCTRL         &kp RCTRL      &kp RET  &kp RSHFT                    &kp UP    &kp DOWN    &kp HASH     &none         &mo 2
            >;
        };
    };
};
